services:
  # 1. Your AutoGen Agent
  autogen-agent:
    build: .
    depends_on:
      - postgres-db  # Wait for DB to start before starting agent
    environment:
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      # Pass DB connection info to your Python script
      - DB_HOST=postgres-db
      - DB_NAME=autogen_memory
      - DB_USER=myuser
      - DB_PASS=mypassword
    volumes:
      - ./:/app
    command: python main.py

  # 2. The Database
  postgres-db:
    image: postgres:15-alpine
    restart: always
    environment:
      - POSTGRES_USER=myuser
      - POSTGRES_PASSWORD=mypassword
      - POSTGRES_DB=autogen_memory
    volumes:
      - postgres_data:/var/lib/postgresql/data # Persist data here
    ports:
      - "5432:5432" # Optional: Access DB from your host machine

volumes:
  postgres_data: # Define the storage volume
